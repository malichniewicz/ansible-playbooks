services:
  frigate:
    container_name: frigate
    image: ghcr.io/blakeblackshear/frigate:stable
    restart: unless-stopped
    shm_size: "256mb"
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /opt/frigate/config:/config
      - /opt/frigate/recordings:/recordings
    ports:
      - "8971:8971"
      - "8554:8554" # RTSP feeds
{% if exposed %}
    # Expose container to Traefik
    networks:
      - {{ exposed_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.frigate.rule=Host(`frigate.alichniewicz.dev`)"
      - "traefik.http.routers.frigate.entrypoints=websecure"
      - "traefik.http.routers.frigate.tls=true"
      - "traefik.http.routers.frigate.tls.certresolver=letencrypt"
      - "traefik.http.services.frigate.loadbalancer.server.port=5000"
      # Forward real IP and proto so Frigate doesn't reject the request
      - "traefik.http.middlewares.frigate-headers.headers.customrequestheaders.X-Forwarded-Proto=https"
networks:
  {{ exposed_docker_network }}:
    name: {{ exposed_docker_network }}
    external: true
    ipam:
      config:
        - subnet: "{{ exposed_docker_network_subnet }}"
{% endif %}
