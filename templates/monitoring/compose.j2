volumes:
  prometheus_data:
  grafana_data:

services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - /opt/monitoring/prometheus/config:/etc/prometheus
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d" # <= adjust the storage retention period of Prometheus
    restart: unless-stopped
    networks:
      - monitoring
{% if exposed %}
      # Expose container to Traefik
      - {{ exposed_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.prometheus.rule=Host(`{{ dns_name.prometheus }}`)"
      - "traefik.http.routers.prometheus.entrypoints=websecure"
      - "traefik.http.routers.prometheus.tls=true"
      - "traefik.http.routers.prometheus.tls.certresolver=letencrypt"
      - "traefik.http.services.prometheus.loadbalancer.server.port=9090"
{% endif %}
  mktxp:
    image: ghcr.io/akpw/mktxp:latest
    container_name: mikrotik-mktxp
    volumes:
      # Since Version v0.37 mktxp runs as single user
      # Prior it was root
      - "/opt/monitoring/providers/mktxp/data:/home/mktxp/mktxp/:rw"
    networks:
      - monitoring
{% if exposed %}
      # Expose container to Traefik
      - {{ exposed_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mktxp.rule=Host(`{{ dns_name.mktxp }}`)"
      - "traefik.http.routers.mktxp.entrypoints=websecure"
      - "traefik.http.routers.mktxp.tls=true"
      - "traefik.http.routers.mktxp.tls.certresolver=letencrypt"
      - "traefik.http.services.mktxp.loadbalancer.server.port=49090"
{% endif %}
    restart: unless-stopped
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/monitoring/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - /opt/monitoring/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards
      - /opt/monitoring/grafana/custom.ini:/etc/grafana/custom.ini
    environment:
      - GF_PATHS_CONFIG=/etc/grafana/custom.ini
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_INSTALL_PLUGINS=flant-statusmap-panel
      - GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/provisioning/dashboards/mikrotik/monitor.json
    restart: unless-stopped
    networks:
      - monitoring
{% if exposed %}
      # Expose container to Traefik
      - {{ exposed_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.monitoring.rule=Host(`{{ dns_name.grafana }}`)"
      - "traefik.http.routers.monitoring.entrypoints=websecure"
      - "traefik.http.routers.monitoring.tls=true"
      - "traefik.http.routers.monitoring.tls.certresolver=letencrypt"
      - "traefik.http.services.monitoring.loadbalancer.server.port=3000"
{% endif %}
networks:
  monitoring:
    internal: true
{% if exposed %}
  {{ exposed_docker_network }}:
    name: {{ exposed_docker_network }}
    external: true
    ipam:
      config:
        - subnet: "{{ exposed_docker_network_subnet }}"
{% endif %}