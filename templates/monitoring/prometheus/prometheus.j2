global:
  scrape_interval:     60s
  evaluation_interval: 60s
  
rule_files:

scrape_configs:
  - job_name: 'mikrotik'
    scrape_interval: 15s
    static_configs:
      - targets: ['mktxp:49090']
  - job_name: node
    static_configs:
      - targets: ['{{ ansible_host }}:9100']
