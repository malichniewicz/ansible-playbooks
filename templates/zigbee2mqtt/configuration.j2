version: 4
advanced:
  channel: 25
mqtt:
  base_topic: {{ mqtt_topic }}
  server: mqtts://{{ dns_name.mosquitto }}:1883
  user: {{ mqtt_user }}
  password: {{ mqtt_password }}
serial:
  port: {{ zigbee_adapter }}
  adapter: ember
  baudrate: 115200
  rtscts: false
frontend:
  enabled: true
  port: 8080
homeassistant:
  enabled: true
ota:
  zigbee_ota_override_index_location: https://raw.githubusercontent.com/romasku/tuya-zigbee-switch/refs/heads/main/zigbee2mqtt/ota/index_end_device.json
